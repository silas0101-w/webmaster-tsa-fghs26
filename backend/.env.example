# Copy to backend/.env for local development. Never commit the real .env.
PORT=3001

# Required when NODE_ENV=production. Use a long random value from the host's secret store.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated exact origins allowed to call the API from a browser.
# Defaults (development only): http://localhost:3000, http://127.0.0.1:3000, http://localhost:4173, http://127.0.0.1:4173
# In production, unset means no cross-origin browser access (same-origin hosting still works).
# CORS_ORIGINS=https://portal.example.org

# Optional SQLite file location (defaults to backend/database.sqlite).
# DATABASE_PATH=./database.sqlite
